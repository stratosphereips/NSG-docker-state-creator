# FM lab server default nginx site — replaces the stock default in the image.
# Public web tier: everything on :80 proxies to the Flask app on loopback:5001.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    access_log /var/log/fm/nginx-access.log;
    error_log  /var/log/fm/nginx-error.log;

    location / {
        proxy_pass http://127.0.0.1:5001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
