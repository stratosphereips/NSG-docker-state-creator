{
  "schema_version": "nsg-state-graph/1.0",
  "profiles": {
    "forensic": {
      "description": "Maximum entity, process, flow, attribute, and raw evidence detail.",
      "process_mode": "instance",
      "include_flows": true,
      "evidence_mode": "full",
      "max_evidence_per_entity": 1000,
      "data_mode": "all",
      "max_data_per_host": 0,
      "include_firewall_rules": true
    },
    "operational": {
      "description": "Decision-oriented hosts, services, selected data, programs, access, and blocks.",
      "process_mode": "program",
      "include_flows": true,
      "evidence_mode": "references",
      "max_evidence_per_entity": 50,
      "data_mode": "configured",
      "max_data_per_host": 2000,
      "include_firewall_rules": true
    },
    "strategic": {
      "description": "Compact host/network/service/data/access/block state for low-context decisions.",
      "process_mode": "none",
      "include_flows": false,
      "evidence_mode": "counts",
      "max_evidence_per_entity": 0,
      "data_mode": "important",
      "max_data_per_host": 250,
      "include_firewall_rules": false
    }
  },
  "data": {
    "include_regex": [
      "^/(etc|home|root|srv|tmp)(/|$)",
      "^/var/(log|lib|www|tmp)(/|$)",
      "\\.(txt|json|jsonl|csv|tsv|ya?ml|xml|ini|conf|cfg|log|db|sqlite3?|sql|pem|key|crt|sh|py|js|ts|md|pdf|docx?|xlsx?|zip|tar|gz)$"
    ],
    "important_regex": [
      "^/etc/(passwd|shadow|group|sudoers|hosts|resolv\\.conf)$",
      "^/(home|root)/.*(/\\.ssh/|authorized_keys|known_hosts|id_[^/]+$)",
      "(^|/)(credentials?|secrets?|tokens?|passwords?|config|settings|database|backup)([._/-]|$)",
      "\\.(pem|key|kdbx|db|sqlite3?|sql|csv|json|ya?ml|conf|env)$"
    ],
    "exclude_regex": [
      "^/observation(/|$)",
      "^/proc(/|$)",
      "^/sys(/|$)",
      "^/dev(/|$)",
      "^/run(/|$)",
      "^/usr/(lib|share|include)(/|$)",
      "^/opt/nsg-observer(/|$)"
    ]
  },
  "observer_process_regex": "(/opt/nsg-observer/(bin|lib|etc)/|state-reconciler|filesystem-monitor|process-monitor|socket-monitor|network-monitor|state-builder|trajectory-monitor|bcc-monitor|inotifywait|tcpdump|(^| )zeek( |$)|(^| )strace( |$)|execsnoop|opensnoop-bpfcc|(^| )ss -H -n -p)",
  "service_names": {
    "20": "ftp-data", "21": "ftp", "22": "ssh", "23": "telnet",
    "25": "smtp", "53": "dns", "67": "dhcp", "68": "dhcp",
    "80": "http", "110": "pop3", "123": "ntp", "135": "msrpc",
    "139": "netbios", "143": "imap", "161": "snmp", "389": "ldap",
    "443": "https", "445": "smb", "465": "smtps", "587": "submission",
    "636": "ldaps", "993": "imaps", "995": "pop3s", "1433": "mssql",
    "1521": "oracle", "2049": "nfs", "2375": "docker", "2376": "docker-tls",
    "3306": "mysql", "3389": "rdp", "5432": "postgresql", "5601": "kibana",
    "5672": "amqp", "5900": "vnc", "6379": "redis", "6443": "kubernetes-api",
    "8080": "http-alt", "8443": "https-alt", "9200": "elasticsearch",
    "11211": "memcached", "27017": "mongodb"
  },
  "block_inference": {
    "zeek_no_reply_states": ["S0", "RSTOS0", "SH", "SHR"],
    "zeek_rejected_states": ["REJ", "RSTR", "RSTO"],
    "minimum_origin_packets": 1,
    "minimum_confidence": 0.5
  },
  "control_inference": {
    "minimum_confidence": 0.8,
    "successful_commands": ["ssh", "scp", "sftp"]
  },
  "trajectory": {
    "snapshot_policy": "material",
    "watched_domains": [
      "known_networks",
      "known_hosts",
      "controlled_hosts",
      "known_data",
      "known_services",
      "known_blocks"
    ],
    "critical_domains": [
      "known_networks",
      "known_hosts",
      "controlled_hosts",
      "known_blocks"
    ],
    "ignore_fields": [
      "generated_at",
      "first_seen",
      "last_seen",
      "evidence",
      "evidence_count",
      "evidence_sources",
      "observations"
    ],
    "confidence_bucket": 0.1,
    "poll_interval_seconds": 0.2,
    "settle_seconds": 2.0,
    "maximum_batch_seconds": 5.0,
    "inferred_idle_seconds": 1.0,
    "maximum_action_seconds": 3600,
    "use_bcc_exec_fallback": true,
    "command_rules": [
      {"type": "network_scan", "scope": "network", "regex": "(^|/| )(nmap|masscan|zmap|rustscan)( |$)"},
      {"type": "network_probe", "scope": "network", "regex": "(^|/| )(ping|traceroute|tracepath|dig|host|nslookup|nc|netcat|telnet)( |$)"},
      {"type": "remote_access", "scope": "network", "regex": "(^|/| )(ssh|scp|sftp|rsync)( |$)"},
      {"type": "network_request", "scope": "network", "regex": "(^|/| )(curl|wget|ftp)( |$)"},
      {"type": "file_change", "scope": "local", "regex": "(^|/| )(cp|mv|rm|mkdir|rmdir|touch|chmod|chown|ln|truncate|dd)( |$)"},
      {"type": "data_access", "scope": "local", "regex": "(^|/| )(cat|head|tail|less|more|grep|find|awk|sed)( |$)"},
      {"type": "package_change", "scope": "local", "regex": "(^|/| )(apt|apt-get|dpkg|pip|pip3|npm|yarn)( |$)"}
    ]
  }
}
