#!/usr/bin/env python3
"""CLI for passive state/action/state trajectory generation."""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

sys.path.insert(0, "/opt/nsg-observer/lib")
if not Path("/opt/nsg-observer/lib/trajectory.py").exists():
    sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from trajectory import PassiveTrajectoryMonitor  # noqa: E402


def arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Build a passive state/action trajectory")
    parser.add_argument("--input", type=Path,
                        default=Path(os.environ.get("OBS_OUTPUT_DIR", "/observation")))
    parser.add_argument("--output", type=Path, default=None)
    parser.add_argument("--level", choices=("forensic", "operational", "strategic"),
                        default=os.environ.get("OBS_STATE_LEVEL", "operational"))
    parser.add_argument("--sensitivity", choices=("always", "material", "critical"),
                        default=os.environ.get("OBS_TRAJECTORY_SENSITIVITY", "material"))
    parser.add_argument("--config", type=Path, default=None)
    parser.add_argument("--watch", action="store_true",
                        help="continue watching; without this flag, process available logs once")
    return parser.parse_args()


def main() -> int:
    args = arguments()
    monitor = PassiveTrajectoryMonitor(
        args.input, args.output or args.input / "trajectory",
        args.level, args.config, args.sensitivity,
    )
    monitor.run(once=not args.watch)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
