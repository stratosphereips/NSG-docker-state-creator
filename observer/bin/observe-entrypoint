#!/usr/bin/env python3
"""PID 1 supervisor for the all-in-one observed container."""

from __future__ import annotations

import json
import os
import pwd
import shlex
import signal
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, "/opt/nsg-observer/lib")
from jsonlog import JsonLog, env_bool  # noqa: E402


ROOT = Path("/opt/nsg-observer")
OUTPUT = Path(os.environ.get("OBS_OUTPUT_DIR", "/observation"))
STATUS = OUTPUT / "health.json"
log = JsonLog("supervisor.jsonl", "supervisor")
children: list[tuple[str, subprocess.Popen]] = []
stopping = False
reported_exits: set[str] = set()


def status(state: str, workload_pid: int | None = None) -> None:
    services = {
        name: {"pid": proc.pid, "running": proc.poll() is None, "returncode": proc.poll()}
        for name, proc in children
    }
    tmp = STATUS.with_suffix(".tmp")
    tmp.write_text(json.dumps({
        "state": state,
        "timestamp": time.time(),
        "workload_pid": workload_pid,
        "services": services,
    }, sort_keys=True), encoding="utf-8")
    tmp.replace(STATUS)


def start(name: str, argv: list[str], cwd: Path | None = None, stdout=None) -> None:
    try:
        proc = subprocess.Popen(
            argv,
            cwd=str(cwd) if cwd else None,
            stdin=subprocess.DEVNULL,
            stdout=stdout if stdout is not None else subprocess.DEVNULL,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
        children.append((name, proc))
        log.write("sensor_started", name=name, pid=proc.pid, argv=argv)
    except Exception as exc:
        log.write("sensor_start_failed", name=name, argv=argv, error=repr(exc))


def enabled(name: str) -> bool:
    return env_bool(name, True)


def as_workload_user(argv: list[str]) -> list[str]:
    spec = os.environ.get("OBS_WORKLOAD_USER", "").strip()
    if not spec:
        return argv

    user, _sep, group = spec.partition(":")
    if not user:
        raise ValueError("OBS_WORKLOAD_USER must start with a user name or UID")

    init_groups = False
    if not group:
        try:
            entry = pwd.getpwnam(user) if not user.isdigit() else pwd.getpwuid(int(user))
            group = str(entry.pw_gid)
            init_groups = not user.isdigit()
        except KeyError:
            group = user
    elif not user.isdigit():
        try:
            pwd.getpwnam(user)
            init_groups = True
        except KeyError:
            init_groups = False

    group_mode = ["--init-groups"] if init_groups else ["--clear-groups"]
    return ["setpriv", "--reuid", user, "--regid", group, *group_mode, "--", *argv]


def start_sensors() -> None:
    if enabled("OBS_ENABLE_PROCESS_SNAPSHOTS"):
        start("process-monitor", [str(ROOT / "bin/process-monitor")])
    if enabled("OBS_ENABLE_SOCKET_SNAPSHOTS"):
        start("socket-monitor", [str(ROOT / "bin/socket-monitor")])
    if enabled("OBS_ENABLE_FILE_EVENTS"):
        start("filesystem-monitor", [str(ROOT / "bin/filesystem-monitor")])
    if enabled("OBS_ENABLE_STATE_RECONCILIATION"):
        start("state-reconciler", [str(ROOT / "bin/state-reconciler")])
    if enabled("OBS_ENABLE_BCC"):
        start("bcc-monitor", [str(ROOT / "bin/bcc-monitor")])

    if enabled("OBS_ENABLE_ZEEK"):
        zeek_dir = OUTPUT / "zeek"
        zeek_dir.mkdir(parents=True, exist_ok=True)
        start(
            "zeek",
            ["zeek", "-C", "-i", os.environ.get("OBS_INTERFACE", "any"),
             str(ROOT / "etc/zeek/local.zeek")],
            cwd=zeek_dir,
            stdout=(OUTPUT / "zeek-console.log").open("ab", buffering=0),
        )

    if enabled("OBS_ENABLE_PCAP"):
        pcap_dir = OUTPUT / "pcap"
        pcap_dir.mkdir(parents=True, exist_ok=True)
        start(
            "pcap",
            ["tcpdump", "-i", os.environ.get("OBS_INTERFACE", "any"), "-n", "-U",
             "-C", os.environ.get("OBS_PCAP_FILE_MB", "100"),
             "-W", os.environ.get("OBS_PCAP_FILE_COUNT", "10"),
             "-Z", "root", "-w", str(pcap_dir / "traffic.pcap")],
            stdout=(OUTPUT / "pcap-console.log").open("ab", buffering=0),
        )


def workload_command(argv: list[str]) -> list[str]:
    command = as_workload_user(argv)
    if env_bool("OBS_ENABLE_TTY_RECORDING", True) and sys.stdin.isatty():
        tty_dir = OUTPUT / "tty"
        tty_dir.mkdir(parents=True, exist_ok=True)
        session = str(time.time_ns())
        command = [
            "script", "-q", "-f",
            "--log-in", str(tty_dir / f"{session}.input"),
            "--log-out", str(tty_dir / f"{session}.output"),
            "--log-timing", str(tty_dir / f"{session}.timing"),
            "--command", shlex.join(command),
        ]
    if env_bool("OBS_ENABLE_STRACE", True):
        trace_dir = OUTPUT / "syscalls"
        trace_dir.mkdir(parents=True, exist_ok=True)
        command = [
            "strace", "-ff", "-ttt", "-T", "-yy", "-s",
            os.environ.get("OBS_STRACE_STRING_LIMIT", "4096"),
            "-o", str(trace_dir / "trace"), "--", *command,
        ]
    return command


def _term_tracees_only(leader_pid: int, signum: int) -> None:
    """Signal every member of the workload's process group EXCEPT the group
    leader (strace itself) so strace keeps tracing the tracees' exits.

    killpg on the workload would TERM strace together with its tracees:
    strace then detaches (untraced) tracees and lingers, so the trace tail
    ends seconds before the workload_exited bracket and the integrity layer
    flags strace_tail_truncated. Terminating only the tracees lets strace
    record their death events, flush, and exit by itself right at the
    bracket."""
    import glob
    try:
        leader_pgid = os.getpgid(leader_pid)
    except ProcessLookupError:
        return
    for stat in glob.glob("/proc/[0-9]*/stat"):
        try:
            with open(stat) as fh:
                fields = fh.read().rsplit(") ", 1)[1].split()
            pid = int(stat.split("/")[2])
            pgid = int(fields[2])
        except (OSError, IndexError, ValueError):
            continue
        if pgid == leader_pgid and pid != leader_pid:
            try:
                os.kill(pid, signum)
            except (ProcessLookupError, PermissionError):
                pass


def stop_workload_only(signum: int) -> None:
    """Shutdown-signal path: signal ONLY the workload (its tracees, not the
    strace wrapper).  Sensors must survive until workload_exited is logged
    and final_census_flush() has the process monitor write its post-exit
    sweep: TERMing them here (the pre-2026-10-26 behaviour ran stop_all on
    the signal) made the monitor flush its last census the instant SIGTERM
    arrived -- 10-30s BEFORE the workload actually exited -- so no census
    record ever landed at/after the workload_exited anchor and every run
    degraded (AFM4:post_exit_census_missing).  Sensor teardown happens in
    main() via stop_all() after the flush."""
    global stopping
    if stopping:
        return
    stopping = True
    for name, proc in children:
        if name != "workload" or proc.poll() is not None:
            continue
        try:
            if env_bool("OBS_ENABLE_STRACE", True):
                _term_tracees_only(proc.pid, signum)
            else:
                os.killpg(proc.pid, signum)
            log.write("sensor_signal", name=name, pid=proc.pid, signal=signum)
        except ProcessLookupError:
            pass


def stop_all(signum: int = signal.SIGTERM) -> None:
    global stopping
    stopping = True
    for name, proc in reversed(children):
        if proc.poll() is None:
            try:
                if name == "workload" and env_bool("OBS_ENABLE_STRACE", True):
                    _term_tracees_only(proc.pid, signum)
                else:
                    os.killpg(proc.pid, signum)
                log.write("sensor_signal", name=name, pid=proc.pid, signal=signum)
            except ProcessLookupError:
                pass


def _straggler_identity(pid: int) -> dict | None:
    """process-monitor's exact census identity (naive stat split, same
    field indexes) so the gone rows join the same (pid, start_ticks)
    identity the monitor's census used."""
    base = Path("/proc") / str(pid)
    try:
        status: dict = {}
        for line in (base / "status").read_text().splitlines():
            if ":" in line:
                key, value = line.split(":", 1)
                status[key] = value.strip()
        stat_fields = (base / "stat").read_text().split()
        if len(stat_fields) <= 21 or not stat_fields[21]:
            return None
        uid_values = status.get("Uid", "-1").split()
        uid = int(uid_values[0]) if uid_values and uid_values[0].isdigit() else -1
        try:
            username = pwd.getpwuid(uid).pw_name
        except KeyError:
            username = str(uid)
        return {
            "pid": pid,
            "start_ticks": stat_fields[21],
            "name": status.get("Name", ""),
            "cmdline": (base / "cmdline").read_bytes()
                        .replace(b"\0", b" ").decode("utf-8", "replace").strip(),
            "uid": [username, str(uid)],
        }
    except (OSError, ValueError):
        return None


def straggler_sweep(term_grace: float = 2.5, kill_grace: float = 3.0) -> None:
    """2026-10-27 amendment: reap the workload-tree stragglers the final
    census saw alive. Their deaths would otherwise land only at docker's
    grace SIGKILL -- after PID 1 exits, unrecorded -- degrading AFM4
    (death_evidence_missing) and FM4.5. The entrypoint (still PID 1, and
    the reaper of everything reparented to it) TERMs then KILLs the
    remaining processes, waits for their /proc entries to vanish, and
    appends process_gone rows in the process monitor's exact schema."""
    own = os.getpid()
    victims: dict[int, dict] = {}
    for item in Path("/proc").glob("[0-9]*"):
        pid = int(item.name)
        if pid in (1, own):
            continue
        identity = _straggler_identity(pid)
        if identity:
            victims[pid] = identity
    if not victims:
        return
    for pid in victims:
        try:
            os.kill(pid, signal.SIGTERM)
        except (ProcessLookupError, PermissionError):
            pass
    deadline = time.monotonic() + term_grace
    while time.monotonic() < deadline and victims:
        _reap_zombies()
        victims = {p: i for p, i in victims.items()
                   if Path("/proc", str(p)).exists()}
        if victims:
            time.sleep(0.1)
    for pid in list(victims):
        try:
            os.kill(pid, signal.SIGKILL)
        except (ProcessLookupError, PermissionError):
            pass
    deadline = time.monotonic() + kill_grace
    while time.monotonic() < deadline and victims:
        _reap_zombies()
        victims = {p: i for p, i in victims.items()
                   if Path("/proc", str(p)).exists()}
        if victims:
            time.sleep(0.1)
    gone_log = JsonLog("processes.jsonl", "process-monitor")
    for pid in sorted(victims):
        identity = victims[pid]
        gone_log.write("process_gone",
                       pid=identity["pid"],
                       start_ticks=identity["start_ticks"],
                       name=identity["name"],
                       cmdline=identity["cmdline"],
                       uid=identity["uid"])
    # Absence reconciliation: identities the final census saw ALIVE
    # (process_seen/process_changed rows) whose deaths landed between that
    # census and now -- e.g. tracees SIGKILLed by PTRACE_O_EXITKILL when
    # the strace wrapper died -- have no process_gone row. At this point
    # every tree member is provably dead or reaped above: any census
    # identity absent from /proc AND absent from the gone log died in that
    # window, and this sweep positively witnesses the absence.
    seen: dict = {}
    gone_keys: set = set()
    try:
        with open(OUTPUT / "processes.jsonl", encoding="utf-8") as fh:
            for line in fh:
                try:
                    row = json.loads(line)
                except ValueError:
                    continue
                event = row.get("event")
                if event in ("process_seen", "process_changed"):
                    ticks = str(row.get("start_ticks") or "")
                    if row.get("pid") is not None and ticks:
                        seen[(int(row["pid"]), ticks)] = row
                elif event == "process_gone":
                    ticks = str(row.get("start_ticks") or "")
                    if row.get("pid") is not None and ticks:
                        gone_keys.add((int(row["pid"]), ticks))
    except OSError:
        seen = {}
    still_live = set()
    for item in Path("/proc").glob("[0-9]*"):
        identity = _straggler_identity(int(item.name))
        if identity:
            still_live.add((identity["pid"], identity["start_ticks"]))
    reconciled = 0
    for key, row in seen.items():
        if key in gone_keys or key in still_live:
            continue
        if key[0] in (1, os.getpid()):
            continue
        gone_log.write("process_gone",
                       pid=key[0],
                       start_ticks=key[1],
                       name=row.get("name", ""),
                       cmdline=row.get("cmdline", ""),
                       uid=row.get("uid", []))
        reconciled += 1
    log.write("straggler_sweep", reaped=len(victims),
              reconciled_absent=reconciled)


def _reap_zombies() -> None:
    while True:
        try:
            pid, _ = os.waitpid(-1, os.WNOHANG)
        except ChildProcessError:
            return
        if pid == 0:
            return


def final_census_flush(grace: float = 3.0) -> None:
    """2026-10-26 campaign amendment: request the process monitor's FINAL
    SWEEP immediately after workload_exited is logged (SIGUSR1; the
    monitor writes one full census pass -- process_seen/process_changed
    for live identities, process_gone reconciliation -- into
    processes.jsonl and exits).  AFM4's residue sweep needs a census tick
    strictly at/after the workload_exited anchor to witness survival;
    without this the monitor's last tick almost always lands a poll
    interval BEFORE the anchor and every run degrades
    (AFM4:post_exit_census_missing)."""
    for name, proc in children:
        if name != "process-monitor" or proc.poll() is not None:
            continue
        try:
            proc.send_signal(signal.SIGUSR1)
            try:
                proc.wait(timeout=grace)
            except subprocess.TimeoutExpired:
                pass  # stop_all's TERM below triggers the deferred flush
        except (ProcessLookupError, OSError):
            pass


def on_signal(signum, _frame) -> None:
    log.write("supervisor_signal", signal=signum)
    stop_workload_only(signum)


def main() -> int:
    if len(sys.argv) < 2:
        print("observe-entrypoint: a workload command is required", file=sys.stderr)
        return 64
    OUTPUT.mkdir(parents=True, exist_ok=True)
    for subdir in ("bcc", "files", "snapshots", "sockets", "syscalls", "tty", "zeek", "pcap"):
        (OUTPUT / subdir).mkdir(exist_ok=True)
    (OUTPUT / "tty").chmod(0o1777)
    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)
    start_sensors()
    warmup = float(os.environ.get("OBS_SENSOR_WARMUP", "2"))
    time.sleep(warmup)

    command = workload_command(sys.argv[1:])
    workload = subprocess.Popen(command, start_new_session=True)
    children.append(("workload", workload))
    log.write("workload_started", pid=workload.pid, requested_argv=sys.argv[1:], effective_argv=command)
    status("running", workload.pid)

    while workload.poll() is None and not stopping:
        status("running", workload.pid)
        for name, proc in children[:-1]:
            if proc.poll() is not None and name not in reported_exits:
                log.write("sensor_exited", name=name, returncode=proc.returncode)
                reported_exits.add(name)
        time.sleep(2)

    if stopping and workload.poll() is None:
        try:
            if env_bool("OBS_ENABLE_STRACE", True):
                _term_tracees_only(workload.pid, signal.SIGTERM)
            else:
                os.killpg(workload.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
    try:
        result = workload.wait(timeout=float(
            os.environ.get("OBS_TRACEE_TERM_GRACE", "10")))
    except subprocess.TimeoutExpired:
        # Tracees ignoring TERM (e.g. samba's slow shutdown, an sshd -D
        # stuck in ppoll): escalate on the TRACEES first so strace still
        # records their deaths; only kill the strace wrapper itself as the
        # last resort.  2026-10-26 campaign amendment: the first grace is
        # OBS_TRACEE_TERM_GRACE (default 10s, was 30) -- the campaign's
        # 30s window let TERM-ignoring tracees hold the bracket open
        # until docker's stop-grace SIGKILL tore down strace mid-flush,
        # losing exactly their death trailers
        # (syscalls:strace_tail_truncated).  Escalating sooner gives
        # strace a clean final flush window inside the container's
        # stop-grace budget.
        try:
            if env_bool("OBS_ENABLE_STRACE", True):
                _term_tracees_only(workload.pid, signal.SIGKILL)
                try:
                    result = workload.wait(timeout=20)
                except subprocess.TimeoutExpired:
                    os.kill(workload.pid, signal.SIGKILL)
                    result = workload.wait()
            else:
                os.killpg(workload.pid, signal.SIGKILL)
                result = workload.wait()
        except ProcessLookupError:
            result = workload.wait()

    log.write("workload_exited", pid=workload.pid, returncode=result)
    # Post-exit census flush BEFORE any sensor teardown: the final sweep's
    # census records timestamp at/after this workload_exited line, giving
    # the AFM4 residue sweep its post-anchor witness (see final_census_flush).
    final_census_flush()
    stop_all()
    deadline = time.monotonic() + 5
    for _name, proc in children:
        if proc is workload:
            continue
        remaining = max(0.05, deadline - time.monotonic())
        try:
            proc.wait(timeout=remaining)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
    # 2026-10-27: reap remaining workload-tree stragglers and record
    # their deaths (see straggler_sweep) BEFORE PID 1 exits.
    straggler_sweep()
    status("stopped", workload.pid)
    return result


if __name__ == "__main__":
    raise SystemExit(main())
