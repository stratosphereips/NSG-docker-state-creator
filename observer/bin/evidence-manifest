#!/usr/bin/env python3
"""Record the SHA-256 manifest of a trusted original before a run."""

import argparse
import hashlib
import json
import os
import stat
from pathlib import Path


def identity(info):
    return (info.st_dev, info.st_ino, info.st_mode, info.st_size,
            info.st_mtime_ns, info.st_ctime_ns)


def capture_file(path, original_stat):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, "rb") as source:
        if identity(os.fstat(fd)) != identity(original_stat):
            raise ValueError(f"file changed before capture: {path}")
        digest = hashlib.file_digest(source, "sha256").hexdigest()
        if identity(os.fstat(fd)) != identity(original_stat):
            raise ValueError(f"file changed during capture: {path}")
    return digest


def capture(path):
    if not path.is_absolute() or path == Path("/") or path.resolve(strict=True) != path:
        raise ValueError("use an absolute file or directory path without symlinks")
    entries = {}
    observed = {}
    pending = [path]
    while pending:
        member = pending.pop()
        info = member.lstat()
        observed[member] = identity(info)
        name = member.relative_to(path).as_posix()
        if stat.S_ISDIR(info.st_mode):
            entries[name] = None
            pending.extend(member.iterdir())
        elif stat.S_ISREG(info.st_mode):
            entries[name] = capture_file(member, info)
        else:
            raise ValueError(f"unsupported evidence type: {member}")
    for member, expected in observed.items():
        if identity(member.lstat()) != expected:
            raise ValueError(f"entry changed during capture: {member}")
    return {"entries": entries}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("path", type=Path)
    args = parser.parse_args()
    try:
        manifest = capture(args.path)
    except (OSError, ValueError, RuntimeError) as error:
        parser.exit(1, f"evidence-manifest: {error}\n")
    print(json.dumps(manifest, sort_keys=True))


if __name__ == "__main__":
    main()
