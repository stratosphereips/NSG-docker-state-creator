#!/usr/bin/env python3
"""CLI for compiling observation artifacts into a state graph."""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, "/opt/nsg-observer/lib")
if not Path("/opt/nsg-observer/lib/stategraph.py").exists():
    sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from stategraph import StateCompiler, watch, write_outputs  # noqa: E402


def arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Build an agent-readable NSG state graph")
    parser.add_argument("--input", type=Path,
                        default=Path(os.environ.get("OBS_OUTPUT_DIR", "/observation")))
    parser.add_argument("--output", type=Path, default=None)
    parser.add_argument("--level", choices=("forensic", "operational", "strategic"),
                        default=os.environ.get("OBS_STATE_LEVEL", "operational"))
    parser.add_argument("--config", type=Path, default=None,
                        help="JSON overrides merged over observer/etc/state-graph.json")
    parser.add_argument("--watch", action="store_true", help="rebuild continuously")
    parser.add_argument("--interval", type=float,
                        default=float(os.environ.get("OBS_STATE_INTERVAL", "10")))
    parser.add_argument("--stdout", action="store_true", help="also print graph JSON")
    return parser.parse_args()


def main() -> int:
    args = arguments()
    output = args.output or args.input / "state"
    if args.watch:
        watch(args.input, output, args.level, args.config, args.interval)
        return 0
    graph = StateCompiler(args.input, args.level, args.config).compile()
    write_outputs(graph, output)
    if args.stdout:
        json.dump(graph, sys.stdout, sort_keys=True, indent=2)
        print()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
