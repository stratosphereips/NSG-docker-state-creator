#!/usr/bin/env python3
"""Poll the container PID namespace and emit lifecycle/session snapshots.

2026-10-26 FINAL-SWEEP AMENDMENT (campaign review): the AFM4 residue
sweep needs a census tick strictly at/after the supervisor's
workload_exited anchor to witness survival (a census that stops before
the anchor leaves residue-vs-clean undecidable ->
AFM4:post_exit_census_missing).  The supervisor therefore sends this
monitor SIGUSR1 immediately after logging workload_exited: the monitor
performs ONE final full sweep (process_seen/process_changed for every
live identity, process_gone reconciliation for everything that vanished
-- the same event vocabulary and processes.jsonl stream, no new schema)
and exits.  SIGTERM during that sweep defers the exit until the sweep's
records are written (the final flush window), so the supervisor's
stop_all right after cannot kill the sweep mid-write.
"""

from __future__ import annotations

import os
import pwd
import signal
import sys
import time
from pathlib import Path

sys.path.insert(0, "/opt/nsg-observer/lib")
from jsonlog import JsonLog  # noqa: E402


log = JsonLog("processes.jsonl", "process-monitor")
interval = float(os.environ.get("OBS_PROCESS_INTERVAL", "0.10"))

#: Set by SIGUSR1 (the supervisor's post-workload_exited final-sweep
#: request) and by SIGTERM (finish the in-flight sweep, then exit).
_flush_and_exit = False


def _request_flush(signum, _frame):
    global _flush_and_exit
    _flush_and_exit = True


signal.signal(signal.SIGUSR1, _request_flush)
signal.signal(signal.SIGTERM, _request_flush)


def text(path: Path, binary: bool = False) -> str:
    try:
        if binary:
            return path.read_bytes().replace(b"\0", b" ").decode("utf-8", "replace").strip()
        return path.read_text(encoding="utf-8", errors="replace").strip()
    except (OSError, PermissionError):
        return ""


def link(path: Path) -> str:
    try:
        return os.readlink(path)
    except OSError:
        return ""


def process_info(pid: int) -> dict:
    base = Path("/proc") / str(pid)
    status = {}
    for line in text(base / "status").splitlines():
        if ":" in line:
            key, value = line.split(":", 1)
            status[key] = value.strip()
    stat_fields = text(base / "stat").split()
    uid_values = status.get("Uid", "-1").split()
    gid_values = status.get("Gid", "-1").split()
    uid = int(uid_values[0]) if uid_values and uid_values[0].isdigit() else -1
    try:
        username = pwd.getpwuid(uid).pw_name
    except KeyError:
        username = str(uid)
    return {
        "pid": pid,
        "tid_count": len(list((base / "task").glob("[0-9]*"))),
        "name": status.get("Name", ""),
        "state": status.get("State", ""),
        "ppid": int(status.get("PPid", "0") or 0),
        "uid": uid_values,
        "gid": gid_values,
        "username": username,
        "capabilities": {
            "inheritable": status.get("CapInh", ""),
            "permitted": status.get("CapPrm", ""),
            "effective": status.get("CapEff", ""),
            "bounding": status.get("CapBnd", ""),
            "ambient": status.get("CapAmb", ""),
        },
        "seccomp": status.get("Seccomp", ""),
        "no_new_privileges": status.get("NoNewPrivs", ""),
        "cmdline": text(base / "cmdline", binary=True),
        "exe": link(base / "exe"),
        "cwd": link(base / "cwd"),
        "root": link(base / "root"),
        "loginuid": text(base / "loginuid"),
        "sessionid": text(base / "sessionid"),
        "cgroup": text(base / "cgroup"),
        "tty_nr": stat_fields[6] if len(stat_fields) > 6 else "",
        "start_ticks": stat_fields[21] if len(stat_fields) > 21 else "",
    }


def main() -> None:
    known: dict[tuple[int, str], dict] = {}
    log.write("monitor_started", interval_seconds=interval)
    while True:
        current: dict[tuple[int, str], dict] = {}
        for item in Path("/proc").glob("[0-9]*"):
            try:
                info = process_info(int(item.name))
            except (OSError, ValueError, ProcessLookupError):
                continue
            if not info["start_ticks"] or not info["name"]:
                # the pid vanished between the /proc listing and this
                # detail read: it was never fully observed, and a record
                # with an empty (pid, start_ticks) identity breaks the
                # census identity contract (PID + kernel start ticks) and
                # degrades the whole stream downstream.  A process that
                # died unobserved is skipped, never logged empty.
                continue
            key = (info["pid"], info["start_ticks"])
            current[key] = info
            if key not in known:
                log.write("process_seen", **info)
            elif info["cmdline"] != known[key]["cmdline"] or info["uid"] != known[key]["uid"]:
                log.write("process_changed", previous=known[key], **info)
        for key, info in known.items():
            if key not in current:
                log.write("process_gone", pid=info["pid"], start_ticks=info["start_ticks"],
                          name=info["name"], cmdline=info["cmdline"], uid=info["uid"])
        known = current
        if _flush_and_exit:
            # Final sweep complete (its records carry timestamps at/after
            # the workload_exited anchor when the supervisor requested
            # it): exit cleanly instead of waiting for SIGKILL.
            return
        # Sleep in short slices so a SIGUSR1 final-sweep request lands
        # within ~50ms instead of a full poll interval.
        deadline = time.monotonic() + interval
        while time.monotonic() < deadline and not _flush_and_exit:
            time.sleep(min(0.05, max(0.0, deadline - time.monotonic())))


if __name__ == "__main__":
    main()
