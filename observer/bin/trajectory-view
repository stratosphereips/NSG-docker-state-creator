#!/usr/bin/env python3
"""CLI wrapper for the resolved trajectory viewer."""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, "/opt/nsg-observer/lib")
if not Path("/opt/nsg-observer/lib/trajectory_view.py").exists():
    sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from trajectory_view import main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(main())
